.bind-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #ffffff 0%, #1989fa 100%);
  padding: 40rpx;
  box-sizing: border-box;
}

.bind-header {
  margin-bottom: 60rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.page-desc {
  font-size: 28rpx;
  color: #666666;
}

.bind-form {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 40rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.form-item {
  margin-bottom: 40rpx;
}

.form-label {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.label-text {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.required {
  color: #ff4d4f;
  margin-left: 4rpx;
}

.form-input {
  width: 100%;
  height: 92rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 8rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #333333;
  background-color: #ffffff;
}

.form-input:focus {
  border-color: var(--primary-color, #1989fa);
}

.form-input::placeholder {
  color: #bfbfbf;
  font-size: 28rpx;
}

.submit-button {
  width: 100%;
  height: 96rpx;
  background-color: var(--primary-color, #1989fa);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  margin: 40rpx 0 20rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(25, 137, 250, 0.3);
}

.submit-button:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.submit-button::after {
  border: none;
}

.submit-button[disabled] {
  background-color: #d9d9d9;
  color: #ffffff;
  box-shadow: none;
}

.form-tips {
  font-size: 24rpx;
  color: #999999;
  line-height: 36rpx;
  text-align: center;
  margin-top: 20rpx;
}

/* 加载遮罩样式 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.3);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999;
}

.loading-content {
  background-color: #ffffff;
  padding: 40rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wx-loading {
  width: 44rpx;
  height: 44rpx;
  border: 4rpx solid rgba(25, 137, 250, 0.3);
  border-radius: 50%;
  border-top-color: var(--primary-color, #1989fa);
  animation: spin 1s linear infinite;
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #666666;
}

/* 旋转动画 */
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 输入框错误状态 */
.form-input.error {
  border-color: #ff4d4f;
}

/* 表单验证错误提示 */
.error-tip {
  font-size: 24rpx;
  color: #ff4d4f;
  margin-top: 8rpx;
}

/* 页面动画 */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.bind-header,
.bind-form {
  animation: fadeInUp 0.6s ease-out;
}

.bind-form {
  animation-delay: 0.2s;
}