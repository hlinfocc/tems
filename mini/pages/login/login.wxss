.login-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: start;
  align-items: center;
  padding: 60rpx 40rpx;
  background: linear-gradient(180deg, #ffffff 0%, #1989fa 100%);
  box-sizing: border-box;
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.app-logo {
  width: 160rpx;
  height: 160rpx;
  background-color: var(--primary-color, #1989fa);
  border-radius: 32rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 30rpx;
  box-shadow: 0 6rpx 20rpx rgba(25, 137, 250, 0.2);
}

.logo-text {
  font-size: 64rpx;
  font-weight: bold;
  color: #ffffff;
}

.app-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.app-slogan {
  font-size: 26rpx;
  color: #999999;
}

.login-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.login-tips {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 40rpx;
}

.login-button {
  width: 100%;
  height: 96rpx;
  background-color: var(--primary-color, #1989fa);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  margin: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(25, 137, 250, 0.3);
}

.login-button:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.login-button::after {
  border: none;
}

.button-text {
  font-size: 32rpx;
  font-weight: 600;
}

.privacy-notice {
  margin-top: 60rpx;
  font-size: 24rpx;
  color: #999999;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  text-align: center;
  line-height: 36rpx;
}

.privacy-link {
  color: var(--primary-color, #1989fa);
  text-decoration: underline;
}

/* 动画效果 */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.login-header,
.login-content {
  animation: fadeInUp 0.6s ease-out;
}

.login-content {
  animation-delay: 0.2s;
}

/* 加载中样式 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.3);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999;
}

.loading-content {
  background-color: #ffffff;
  padding: 40rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #666666;
}