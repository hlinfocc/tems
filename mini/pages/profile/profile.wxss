/* profile.wxss */
.container {
  padding-bottom: 20px;
}

/* 用户信息卡片 */
.user-card {
  padding: 24px 16px;
  display: flex;
  align-items: center;
  color: white;
}

.user-info {
  display: flex;
  align-items: center;
  width: 100%;
}

/* 未登录状态样式 */
.login-tip {
  color: white;
  font-size: 18px;
  font-weight: 600;
}

.login-subtitle {
  font-size: 14px;
  opacity: 0.8;
  margin-top: 4px;
}

.login-btn {
  padding: 8px 20px;
  background-color: rgba(255, 255, 255, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 20px;
  font-size: 14px;
  font-weight: 500;
}

/* 已登录状态样式 */
.avatar {
  width: 80px;
  height: 80px;
  border-radius: 40px;
  border: 2px solid rgba(255, 255, 255, 0.5);
}

.user-details {
  margin-left: 16px;
  flex: 1;
}

.user-name {
  font-size: 20px;
  font-weight: 600;
  margin-bottom: 4px;
}

.user-id {
  font-size: 14px;
  opacity: 0.8;
  margin-bottom: 4px;
}

.user-class {
  font-size: 13px;
  opacity: 0.7;
}

/* 功能列表 */
.menu-section {
  margin-top: 16px;
  background-color: white;
}

.menu-item {
  font-size: 16px;
}

.menu-text {
  color: #333;
}

.menu-arrow {
  display: flex;
  align-items: center;
}

.arrow-icon {
  width: 16px;
  height: 16px;
  opacity: 0.5;
}

/* 信息统计 */
.info-section {
  display: flex;
  background-color: white;
  margin-top: 16px;
  padding: 20px 0;
}

.info-item {
  flex: 1;
  text-align: center;
}

.info-label {
  font-size: 14px;
  color: #666;
  margin-bottom: 8px;
}

.info-value {
  font-size: 24px;
  font-weight: 600;
  color: #333;
}

/* 版本信息 */
.version-info {
  text-align: center;
  margin-top: 24px;
  font-size: 12px;
  color: #999;
}